---
interface Props {
  name: string;
  description: string;
  url: string;
  language?: string | null;
  stars?: number;
  topics?: string[];
  featured?: boolean;
}

const { name, description, url, language, stars = 0, topics = [], featured = false } = Astro.props;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class:list={[
    'group flex flex-col rounded-xl border border-border bg-surface p-5 transition-all hover:border-accent/50 hover:bg-surface-light',
    featured && 'ring-1 ring-accent/20',
  ]}
>
  <div class="flex items-start justify-between gap-3 mb-2">
    <h3 class="font-semibold text-ink group-hover:text-accent transition-colors flex items-center gap-2">
      <svg class="h-4 w-4 text-ink-dim shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.21 3.44 9.63 8.21 11.19.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.71-4.04-1.58-4.04-1.58-.55-1.36-1.34-1.72-1.34-1.72-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.21 1.84 1.21 1.07 1.79 2.81 1.27 3.49.97.11-.76.42-1.27.76-1.56-2.67-.3-5.47-1.31-5.47-5.81 0-1.28.47-2.33 1.24-3.15-.13-.3-.54-1.51.12-3.15 0 0 1.01-.32 3.3 1.2a11.6 11.6 0 0 1 3-.39c1.02 0 2.05.13 3 .39 2.29-1.52 3.3-1.2 3.3-1.2.66 1.64.25 2.85.12 3.15.77.82 1.24 1.87 1.24 3.15 0 4.51-2.81 5.5-5.49 5.79.43.36.81 1.08.81 2.18 0 1.57-.01 2.84-.01 3.23 0 .31.21.68.83.56A12.01 12.01 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z" />
      </svg>
      {name}
    </h3>
    <svg class="h-4 w-4 text-ink-dim group-hover:text-accent transition-all group-hover:translate-x-0.5 group-hover:-translate-y-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
    </svg>
  </div>

  <p class="text-sm text-ink-muted leading-relaxed grow">{description}</p>

  {topics.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-4">
      {topics.slice(0, 4).map((topic) => (
        <span class="text-xs font-mono text-accent/80 bg-accent/10 rounded px-2 py-0.5">{topic}</span>
      ))}
    </div>
  )}

  <div class="flex items-center gap-4 mt-4 pt-4 border-t border-border text-xs text-ink-dim">
    {language && (
      <span class="flex items-center gap-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-spark"></span>
        {language}
      </span>
    )}
    {stars > 0 && (
      <span class="flex items-center gap-1">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .587l3.668 7.431 8.2 1.192-5.934 5.784 1.401 8.168L12 18.896l-7.335 3.866 1.401-8.168L.132 9.21l8.2-1.192z" />
        </svg>
        {stars}
      </span>
    )}
  </div>
</a>
